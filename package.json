{
  "name": "assetto-server-manager",
  "version": "0.0.4",
  "description": "GUI Launcher and Manager for AssettoServer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.assetto.servermanager",
    "productName": "Assetto Corsa Server Manager",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "files": [
      "**/*",
      "!node_modules/*",
      "node_modules/ini/**/*",
      "node_modules/yaml/**/*"
    ]
  },
  "dependencies": {
    "ini": "^4.1.1",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}